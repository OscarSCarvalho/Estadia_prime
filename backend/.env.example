PORTA=3001
CAMINHO_BANCO=./data/estadia.db
SEGREDO_SESSAO=troque-por-uma-frase-longa-e-aleatoria-com-32-ou-mais-caracteres
PASTA_UPLOADS=./uploads
CUSTO_HASH_SENHA=12
COMISSAO_HOSPEDAGEM_PCT=12
COMISSAO_SERVICO_PCT=15
# Só desenvolvimento: mostra imóveis/serviços na busca sem subconta Asaas aprovada (RN13). Proibido em produção
PERMITIR_SEM_RECEBIMENTO=false

# Pagamento (CONTEXT §4.4 e §7). falso = gateway em memória (padrão, desenvolvimento e testes); asaas = API do Asaas
GATEWAY_PAGAMENTO=falso
# Sandbox. Produção: https://api.asaas.com/v3 (só no servidor de produção; fora dele é recusada)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Chave da conta principal no Asaas (sandbox começa com $aact_hmlg_). Nunca use a chave de produção aqui
ASAAS_API_KEY=
# 32+ caracteres aleatórios. O mesmo valor vai no painel do Asaas (Integrações > Webhooks > Token de autenticação)
ASAAS_WEBHOOK_TOKEN=
# 64 caracteres hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAVE_CRIPTOGRAFIA=
# Endereço público do site (retorno da fatura de cartão e webhook das subcontas). Em produção: https://
URL_PUBLICA_SITE=http://localhost:5173
