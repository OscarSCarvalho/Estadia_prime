{
  "name": "estadia-prime-backend",
  "version": "0.2.0",
  "private": true,
  "description": "API do marketplace Estadia Prime",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "db:testar": "node scripts/testar-banco.js",
    "db:demonstracao": "node --env-file-if-exists=.env scripts/demonstracao.js",
    "db:demonstracao-avaliacoes": "node --env-file-if-exists=.env scripts/demonstracao-avaliacoes.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
